
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/customer_support
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=customer_support
MYSQL_CA_PATH=
RUN_DB_TESTS=false
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
JWT_EXPIRES_IN=1h
JWT_COOKIE_NAME=supportpilot_access
JWT_COOKIE_MAX_AGE_MS=3600000
JWT_COOKIE_SAME_SITE=lax
JWT_COOKIE_SECURE=false
COMPANY_REGISTRATION_STATUS=Active
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email Configuration (Gmail SMTP - Port 587 with STARTTLS)
MAIL_USER=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password
MAIL_FROM=your_gmail@gmail.com
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM=your_gmail@gmail.com
APP_NAME=SupportPilot
