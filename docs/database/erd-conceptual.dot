graph C {
graph [layout=neato, overlap=false, sep="+8", start=7, splines=true, fontname="Helvetica", bgcolor="white", pad=0.2];
node [fontname="Helvetica-Bold", fontsize=22, fontcolor="black", color="black"];
edge [color="black", fontname="Helvetica-Bold", fontsize=20, fontcolor="black", penwidth=1.6];
Role [shape=box, style=bold, penwidth=2.2, label="Role", margin="0.15,0.08"];
User [shape=box, style=bold, penwidth=2.2, label="User", margin="0.15,0.08"];
Company [shape=box, style=bold, penwidth=2.2, label="Company", margin="0.15,0.08"];
CompanyAdmin [shape=box, style=bold, penwidth=2.2, label="CompanyAdmin", margin="0.15,0.08"];
PasswordResetToken [shape=box, style=bold, penwidth=2.2, label="PasswordResetToken", margin="0.15,0.08"];
Ticket [shape=box, style=bold, penwidth=2.2, label="Ticket", margin="0.15,0.08"];
TicketReply [shape=box, style=bold, penwidth=2.2, label="TicketReply", margin="0.15,0.08"];
FAQ [shape=box, style=bold, penwidth=2.2, label="FAQ", margin="0.15,0.08"];
AISettings [shape=box, style=bold, penwidth=2.2, label="AISettings", margin="0.15,0.08"];
ChatSession [shape=box, style=bold, penwidth=2.2, label="ChatSession", margin="0.15,0.08"];
ChatMessage [shape=box, style=bold, penwidth=2.2, label="ChatMessage", margin="0.15,0.08"];
r0 [shape=diamond, label="has", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
Role -- r0 [label="1"];
r0 -- User [label="N"];
r1 [shape=diamond, label="employs / serves", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
Company -- r1 [label="1"];
r1 -- User [label="N"];
r2 [shape=diamond, label="managed by", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
Company -- r2 [label="1"];
r2 -- CompanyAdmin [label="1"];
r3 [shape=diamond, label="acts as", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
User -- r3 [label="1"];
r3 -- CompanyAdmin [label="0..1"];
r4 [shape=diamond, label="requests", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
User -- r4 [label="1"];
r4 -- PasswordResetToken [label="N"];
r5 [shape=diamond, label="owns", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
Company -- r5 [label="1"];
r5 -- Ticket [label="N"];
r6 [shape=diamond, label="raises", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
User -- r6 [label="1"];
r6 -- Ticket [label="N"];
r7 [shape=diamond, label="is assigned", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
User -- r7 [label="1"];
r7 -- Ticket [label="N"];
r8 [shape=diamond, label="contains", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
Ticket -- r8 [label="1"];
r8 -- TicketReply [label="N"];
r9 [shape=diamond, label="writes", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
User -- r9 [label="1"];
r9 -- TicketReply [label="N"];
r10 [shape=diamond, label="publishes", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
Company -- r10 [label="1"];
r10 -- FAQ [label="N"];
r11 [shape=diamond, label="configures", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
Company -- r11 [label="1"];
r11 -- AISettings [label="1"];
r12 [shape=diamond, label="hosts", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
Company -- r12 [label="1"];
r12 -- ChatSession [label="N"];
r13 [shape=diamond, label="starts", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
User -- r13 [label="1"];
r13 -- ChatSession [label="N"];
r14 [shape=diamond, label="escalates to", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
ChatSession -- r14 [label="0..1"];
r14 -- Ticket [label="1"];
r15 [shape=diamond, label="contains", fontsize=17, fontname="Helvetica", margin="0.02,0.02"];
ChatSession -- r15 [label="1"];
r15 -- ChatMessage [label="N"];
}