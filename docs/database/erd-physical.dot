 port="created_by_r">int NULL</td></tr></table>>];
company_ai_settings [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="black"><tr><td colspan="3" bgcolor="#d9d9d9" align="center"><b>company_ai_settings</b></td></tr><tr><td align="left" port="settings_id">PK</td><td align="left"><b>settings_id</b></td><td align="left" port="settings_id_r">int</td></tr><tr><td align="left" port="company_id">FK,UK</td><td align="left"><i>company_id</i></td><td align="left" port="company_id_r">int</td></tr><tr><td align="left" port="enabled"></td><td align="left">enabled</td><td align="left" port="enabled_r">tinyint(1)</td></tr><tr><td align="left" port="assistant_name"></td><td align="left">assistant_name</td><td align="left" port="assistant_name_r">varchar(40)</td></tr><tr><td align="left" port="tone"></td><td align="left">tone</td><td align="left" port="tone_r">varchar(20)</td></tr><tr><td align="left" port="greeting"></td><td align="left">greeting</td><td align="left" port="greeting_r">varchar(300)</td></tr><tr><td align="left" port="answer_from_faqs_only"></td><td align="left">answer_from_faqs_only</td><td align="left" port="answer_from_faqs_only_r">tinyint(1)</td></tr><tr><td align="left" port="confidence_threshold"></td><td align="left">confidence_threshold</td><td align="left" port="confidence_threshold_r">tinyint unsigned</td></tr><tr><td align="left" port="escalate_after_failures"></td><td align="left">escalate_after_failures</td><td align="left" port="escalate_after_failures_r">tinyint unsigned</td></tr><tr><td align="left" port="fallback_message"></td><td align="left">fallback_message</td><td align="left" port="fallback_message_r">varchar(300)</td></tr><tr><td align="left" port="custom_instructions"></td><td align="left">custom_instructions</td><td align="left" port="custom_instructions_r">text NULL</td></tr><tr><td align="left" port="updated_by"></td><td align="left">updated_by</td><td align="left" port="updated_by_r">int NULL</td></tr><tr><td align="left" port="created_at"></td><td align="le