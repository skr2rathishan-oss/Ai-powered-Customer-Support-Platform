roles:role_id_r:e -> users:role_id:w [arrowtail=teetee, arrowhead=crowodot];
companies:company_id_r:e -> users:company_id:w [arrowtail=teeodot, arrowhead=crowodot];
users:user_id_r:e -> company_admins:admin_id:w [arrowtail=teetee, arrowhead=teeodot];
