digraph ERD {
graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, newrank=true, fontname="Helvetica", bgcolor="white", pad=0.2];
node [shape=plain, fontname="Helvetica", fontsize=10, fontcolor="black"];
edge [color="black", fontname="Helvetica", fontsize=8, penwidth=1.0, dir=both];
roles [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="black"><tr><td colspan="3" bgcolor="#d9d9d9" align="center"><b>roles</b></td></tr><tr><td align="left" port="role_id">PK</td><td align="left"><b>role_id</b></td><td align="left" port="role_id_r">int</td></tr><tr><td align="left" port="role_name">UK</td><td align="left">role_name</td><td align="left" port="role_name_r">varchar(50)</td></tr><tr><td align="left" port="description"></td><td align="left">description</td><td align="left" port="description_r">varchar(255) NULL</td></tr></table>>];
companies [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="black"><tr><td colspan="3" bgcolor="#d9d9d9" align="center"><b>companies</b></td></tr><tr><td align="left" port="company_id">PK</td><td align="left"><b>company_id</b></td><td align="left" port="company_id_r">int</td></tr><tr><td align="left" port="company_name"></td><td align="left">company_name</td><td align="left" port="company_name_r">varchar(150)</td></tr><tr><td align="left" port="industry"></td><td align="left">industry</td><td align="left" port="industry_r">varchar(100) NULL</td></tr><tr><td align="left" port="business_email">UK</td><td align="left">business_email</td><td align="left" port="business_email_r">varchar(150)</td></tr><tr><td align="left" port="company_phone"></td><td align="left">company_phone</td><td align="left" port="company_phone_r">varchar(20) NULL</td></tr><tr><td align="left" port="website_url"></td><td align="left">website_url</td><td align="left" port="website_url_r">varchar(255) NULL</td></tr><tr><td align="left" port="description"></td><td align="left">description</td><td align="left" port="description_r">text NULL</td></tr><tr><td align="left" port="status"></td><td align="left">status</td><td align="left" port="status_r">enum NULL</td></tr><tr><td align="left" port="registration_date"></td><td align="left">registration_date</td><td align="left" port="registration_date_r">timestamp NULL</td></tr><tr><td align="left" port="updated_at"></td><td align="left">updated_at</td><td align="left" port="updated_at_r">timestamp NULL</td></tr></table>>];
