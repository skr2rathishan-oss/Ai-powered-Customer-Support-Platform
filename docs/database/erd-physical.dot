chat_sessions:session_id_r:e -> chat_messages:session_id:w [arrowtail=teetee, arrowhead=crowodot];
{rank=same; roles; companies; platform_settings;}
{rank=same; tickets; faqs; company_admins; password_reset_tokens; company_ai_settings;}
{rank=same; ticket_replies; chat_sessions;}
}